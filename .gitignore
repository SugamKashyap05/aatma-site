# Phase 1 hero pipeline: source PNGs are re-downloadable scratch.
# The generated .avif/.webp variants and generated.ts ARE committed,
# because the CI build consumes them directly.
scripts/.hero-cache/
scripts/.optimize.log

# Phase 1 hero: regenerated variant logs
scripts/.opt*.log

# Ad-hoc test scratch files (root-level only)
/*-test.cjs
/test-report-*.md

# Local-only scratch: full-resolution generated source PNGs.
# The optimised .avif/.webp/.png variants in public/research/ ARE committed.
/_mai_generated/

# Client source documents (scanned PDFs, internal correspondence).
# Kept locally for reference; not published.
/documents/

# Transient verification scaffolding
/_verify/

# Hermes Agent session state — model routing, provider config, local
# scratch paths and kanban WIP rules. Tooling-local, never published.
.hermes/

# Generated demo HTML used to visualise the redesign before implementation.
# Scratch only — the real components live under src/.
/cache/

# Large scanned PDF (107 MiB) — above GitHub's 100 MiB per-file limit for
# repository contents, so it cannot be committed. It is served from GitHub
# Releases instead; see src/data/books.ts for the URL.
# The in-page reader does not use this file: it renders the per-page scans
# under public/books/proceedings/pages/, which ARE committed.
/public/books/proceedings-seminar-2001.pdf

# Ad-hoc verification scratch. These are throwaway probes and captured
# screenshots/JSON reports, not project code — keep them out of the repo.
# Nothing under scripts/ with a .cjs or .json extension is tracked; the
# committed scripts are all .mjs.
/.kanban-scratch/
/_verify*.mjs
/_verify*.json
/_verify*.txt
/scripts/*.cjs
/scripts/*.json
/scripts/smoke-screenshots/
/scripts/verify-press-news.mjs
/docs/_scratch_*.md

# Local-only working copies of the client scans (164 MB, incl. a 112 MB PDF
# above GitHub's 100 MiB per-file limit). The publishable files live under
# public/; these are the raw originals kept out of the repository.
/assestes images/
